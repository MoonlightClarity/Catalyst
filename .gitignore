# Catalyst developer release
#
# Developer documentation, research notes, specifications, decision logs,
# source code, scripts, test fixtures, collaboration tooling, and useful
# project history are intentionally NOT ignored.
#
# This includes material useful for handing Catalyst to another developer
# working with ChatGPT: CURRENT_STATE.md, DECISION_LOG.md, NEXT_STEPS.md,
# SOURCE_INDEX.md, docs/conversation-continuity.md, workspace-maintenance.md,
# and tools/chatgpt-bridge-extension/.

# Dependencies
node_modules/

# Generated build output
dist/
build/
out/

# TypeScript / Vite caches
*.tsbuildinfo
.vite/
.cache/

# Generated test / coverage output
coverage/
test-results/
playwright-report/
.nyc_output/

# Temporary working material
tmp/
temp/
__pycache__/
*.py[cod]
*.tmp
*.bak
*.swp
*~

# Backup variants created by local patch/research work
*.bak-*
tools/research-probes/**/backups/

# Local backup / rollback material
.catalyst-backups/
.chatgpt-backups/
.rollback/

# Logs and crash output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# Local runtime databases and Catalyst sessions
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.catalyst.xml

# Editor / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Generated release packages
release/
releases/
Catalyst-Binary/
catalyst-*.zip
catalyst-*-SHA256SUMS.txt

# Retired/dead material is kept locally but not published in the source release.
archive/

# Third-party Opera connector reference copies are local research inputs, not Catalyst source.
tools/opera-browser-connector-reference/

# Generated browser profiles from local research probes
# Keep the probe scripts/results, but never commit browser state.
tools/research-probes/**/*-profile/

# Legacy build products (keep legacy source itself)
legacy/tauri-shell/target/

# Sensitive recovery material
github-recovery-codes.txt
